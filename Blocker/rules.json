{
  "version": 6,
  "instagram": {
    "homeURL": "https://www.instagram.com/",
    "blockedPaths": [
      "/reels/",
      "/reel/",
      "/explore/"
    ],
    "allowedPaths": [
      "/explore/search"
    ],
    "redirects": {
      "/explore/": "/explore/search/",
      "/explore": "/explore/search/"
    },
    "hideSelectors": [
      "a[href*='/reels/']"
    ],
    "collapseSelectors": [
      "article:has(a[href*='/reel/'])"
    ],
    "videoAllowedPaths": [
      "/stories/"
    ],
    "videoAllowedIn": [
      "article"
    ],
    "singleVideoPaths": [
      "/direct/"
    ],
    "viewerCloseSelector": "svg[aria-label='Close']",
    "allowedHosts": [
      "facebook.com",
      "meta.com"
    ],
    "readySelector": "article"
  },
  "youtube": {
    "homeURL": "https://m.youtube.com/",
    "blockedPaths": [
      "/shorts"
    ],
    "hideSelectors": [
      "ytm-reel-shelf-renderer",
      "ytm-shorts-lockup-view-model",
      "ytm-rich-section-renderer:has(ytm-shorts-lockup-view-model)",
      "a[href^='/shorts']",
      "ytm-pivot-bar-item-renderer:has(.pivot-shorts)"
    ],
    "allowedHosts": [
      "google.com",
      "youtu.be"
    ],
    "readySelector": "ytm-rich-item-renderer, ytm-video-with-context-renderer, ytm-compact-video-renderer"
  }
}
